{
  "name": "printer-use",
  "version": "0.2.0",
  "description": "Printer setup, repair and printing for any AI agent, with guardrails. MCP server, CLI and desktop app.",
  "author": "October",
  "license": "MIT",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:cli": "esbuild src/cli/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=out/cli/printer-use.mjs --banner:js=\"#!/usr/bin/env node\"",
    "start": "electron-vite preview",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "package": "electron-vite build && electron-builder --dir"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "framer-motion": "^11.18.2",
    "lucide-react": "^0.454.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "dev.october.printer-use",
    "productName": "Printer Use",
    "files": [
      "out/**/*",
      "resources/**/*"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": "dir"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/october-dev/printer-use.git"
  },
  "homepage": "https://github.com/october-dev/printer-use#readme",
  "bugs": {
    "url": "https://github.com/october-dev/printer-use/issues"
  },
  "keywords": [
    "printer",
    "cups",
    "lp",
    "agent",
    "claude-code",
    "codex",
    "cli",
    "electron",
    "macos",
    "mcp",
    "mcp-server"
  ],
  "bin": {
    "printer-use": "out/cli/printer-use.mjs"
  }
}
